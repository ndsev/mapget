                         std::make_unique<ResponseStream>(conn->sendAsyncStream(
@@ -1059,7 +1059,7 @@
                 }
                 else
                 {
-                    LOG_INFO << "Chunking Set CloseConnection !!!";
+                    LOG_INFO << "Async stream not supported for HTTP/1.0";
                 }
             }
             auto &streamCallback = respImplPtr->streamCallback();
